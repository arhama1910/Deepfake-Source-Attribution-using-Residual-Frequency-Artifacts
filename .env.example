# ==============================================================================
# DeepTrace AI Configuration Environment Variables
# ==============================================================================

# Database Configuration (PostgreSQL for Docker/Production, SQLite default for local run)
DATABASE_URL=sqlite:///./deeptrace.db
# DATABASE_URL=postgresql://deeptrace_user:deeptrace_password@localhost:5432/deeptrace_db

# Storage Abstraction (local or s3)
STORAGE_TYPE=local
UPLOAD_DIR=./backend/uploads
STATIC_DIR=./backend/static
REPORTS_DIR=./backend/reports
MAX_UPLOAD_SIZE_MB=100

# Machine Learning Checkpoint Weights
# When unweighted, engine runs in Research Demo Preprocessing Mode
IMAGE_MODEL_PATH=
VIDEO_MODEL_PATH=
MODEL_DEVICE=cpu

# Explainable AI (LLM) Integration
# Providers: deterministic (offline, zero-hallucination rule-based), openai, llama, qwen
LLM_PROVIDER=deterministic
LLM_API_KEY=
LLM_API_BASE=
LLM_MODEL_NAME=gpt-4o-mini

# CORS Origin Configuration
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173","http://127.0.0.1:3000"]
